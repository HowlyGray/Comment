rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ==================== HELPER FUNCTIONS ====================

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Validate that a string field exists and is non-empty
    function isNonEmptyString(field) {
      return field is string && field.size() > 0;
    }

    // Validate that a field is a valid timestamp (positive integer)
    function isValidTimestamp(field) {
      return field is int && field > 0;
    }

    // ==================== USERS ====================

    match /users/{userId} {
      // Only authenticated users can read profiles
      allow read: if isSignedIn();
      // Only the user can create/update their own profile
      allow create: if isOwner(userId)
                      && isNonEmptyString(request.resource.data.username)
                      && isNonEmptyString(request.resource.data.email)
                      && request.resource.data.id == userId;
      allow update: if isOwner(userId)
                      && request.resource.data.id == userId;
      allow delete: if isOwner(userId);
    }

    // ==================== POSTS ====================

    match /posts/{postId} {
      // Public posts can be read by authenticated users, private posts only by the author
      allow read: if isSignedIn()
                    && (resource.data.visibility == 'PUBLIC'
                        || resource.data.authorId == request.auth.uid);
      // Only signed-in users can create posts with valid data
      allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && isNonEmptyString(request.resource.data.authorId)
                      && request.resource.data.mediaType in ['IMAGE', 'VIDEO', 'TEXT']
                      && request.resource.data.visibility in ['PUBLIC', 'PRIVATE', 'FOLLOWERS']
                      && isValidTimestamp(request.resource.data.timestamp);
      // Only the author can update/delete their posts, authorId cannot be changed
      allow update: if isSignedIn()
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ==================== COMMENTS ====================

    match /comments/{commentId} {
      // Only authenticated users can read comments
      allow read: if isSignedIn();
      // Only signed-in users can create comments with valid data
      allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && isNonEmptyString(request.resource.data.content)
                      && isNonEmptyString(request.resource.data.postId);
      // Only the author can update/delete their comments
      allow update: if isSignedIn()
                      && resource.data.authorId == request.auth.uid
                      && request.resource.data.authorId == resource.data.authorId;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ==================== CONVERSATIONS ====================

    match /conversations/{conversationId} {
      // Only participants can read the conversation
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Only participants can create conversations (min 2 participants)
      allow create: if isSignedIn()
                      && request.auth.uid in request.resource.data.participantIds
                      && request.resource.data.participantIds.size() >= 2;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Only participants can delete conversations
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;

      // Messages as subcollection of conversations
      match /messages/{messageId} {
        // Only conversation participants can read messages
        allow read: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Only sender who is a participant can create messages
        allow create: if isSignedIn()
                        && request.resource.data.senderId == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds
                        && isNonEmptyString(request.resource.data.senderId)
                        && request.resource.data.type in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO', 'FILE', 'LOCATION', 'CONTACT', 'STICKER'];
        // Only the sender can update their own messages (must be participant)
        allow update: if isSignedIn()
                        && resource.data.senderId == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        // Only the sender can delete their own messages (must be participant)
        allow delete: if isSignedIn()
                        && resource.data.senderId == request.auth.uid
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;

        // Reactions as subcollection of messages
        match /reactions/{reactionId} {
          allow read: if isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
          allow create, update: if isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
          allow delete: if isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participantIds;
        }
      }
    }

    // ==================== LEGACY MESSAGES (top-level) ====================

    match /messages/{messageId} {
      function isParticipantForRead() {
        let conversationId = resource.data.conversationId;
        let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
        return request.auth.uid in conversation.data.participantIds;
      }

      function isParticipantForCreate() {
        let conversationId = request.resource.data.conversationId;
        let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
        return request.auth.uid in conversation.data.participantIds;
      }

      // Only conversation participants can read messages
      allow read: if isSignedIn() && isParticipantForRead();
      // Only sender who is a participant can create messages
      allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && isParticipantForCreate()
                      && request.resource.data.type in ['TEXT', 'IMAGE', 'VIDEO', 'AUDIO', 'FILE', 'LOCATION', 'CONTACT', 'STICKER'];
      // Only the sender can update their own messages (must be participant)
      allow update: if isSignedIn()
                      && resource.data.senderId == request.auth.uid
                      && isParticipantForRead();
      // Only the sender can delete their own messages (must be participant)
      allow delete: if isSignedIn()
                      && resource.data.senderId == request.auth.uid
                      && isParticipantForRead();
    }

    // ==================== USER FOLLOWS ====================

    match /user_follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.followerId == request.auth.uid
                      && isNonEmptyString(request.resource.data.followingId)
                      && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // Alias for follows collection used by FirestoreManager
    match /follows/{followId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.followerId == request.auth.uid
                      && isNonEmptyString(request.resource.data.followingId)
                      && request.resource.data.followerId != request.resource.data.followingId;
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    // ==================== SHARED SPACES ====================

    match /shared_spaces/{spaceId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if isSignedIn()
                      && request.resource.data.creatorId == request.auth.uid
                      && request.auth.uid in request.resource.data.memberIds
                      && isNonEmptyString(request.resource.data.name);
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;

      // Media subcollection
      match /media/{mediaId} {
        allow read: if isSignedIn()
                      && request.auth.uid in get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data.memberIds;
        allow create: if isSignedIn()
                        && request.auth.uid in get(/databases/$(database)/documents/shared_spaces/$(spaceId)).data.memberIds;
        allow update, delete: if isSignedIn()
                        && resource.data.uploaderId == request.auth.uid;
      }
    }

    // ==================== MEDIA ====================

    match /media/{mediaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.uploaderId == request.auth.uid
                      && request.resource.data.type in ['IMAGE', 'VIDEO', 'AUDIO'];
      allow update, delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // ==================== STORIES ====================

    match /stories/{storyId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid
                      && request.resource.data.mediaType in ['IMAGE', 'VIDEO']
                      && isValidTimestamp(request.resource.data.expiresAt);
      // Allow author full update, allow others only to update viewedBy/viewCount
      allow update: if isSignedIn()
                      && (resource.data.authorId == request.auth.uid
                          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy', 'viewCount']));
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ==================== REELS ====================

    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                      && request.resource.data.authorId == request.auth.uid;
      allow update: if isSignedIn()
                      && resource.data.authorId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // ==================== CALLS ====================

    match /calls/{callId} {
      allow read: if isSignedIn()
                    && (request.auth.uid == resource.data.callerId
                        || request.auth.uid == resource.data.receiverId);
      allow create: if isSignedIn()
                      && request.resource.data.callerId == request.auth.uid
                      && isNonEmptyString(request.resource.data.receiverId)
                      && request.resource.data.callType in ['VOICE', 'VIDEO'];
      allow update: if isSignedIn()
                      && (request.auth.uid == resource.data.callerId
                          || request.auth.uid == resource.data.receiverId);
      allow delete: if isSignedIn()
                      && (request.auth.uid == resource.data.callerId
                          || request.auth.uid == resource.data.receiverId);
    }

    // ==================== PRESENCE ====================

    match /presence/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // ==================== TYPING ====================

    match /typing/{typingId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
                              && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn();
    }

    // ==================== FCM TOKENS ====================

    match /fcm_tokens/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}
