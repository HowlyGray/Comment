rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      // Anyone can read user profiles
      allow read: if true;
      // Only the user can create/update their own profile
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Posts collection
    match /posts/{postId} {
      // Public posts can be read by anyone, private posts only by the author
      allow read: if resource.data.visibility == 'PUBLIC'
                    || (isSignedIn() && resource.data.authorId == request.auth.uid);
      // Only signed-in users can create posts
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Only the author can update/delete their posts
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Comments collection
    match /comments/{commentId} {
      // Anyone can read comments
      allow read: if true;
      // Only signed-in users can create comments
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Only the author can update/delete their comments
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Conversations collection
    match /conversations/{conversationId} {
      // Only participants can read the conversation
      allow read: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Only participants can create/update conversations
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantIds;
      allow update: if isSignedIn() && request.auth.uid in resource.data.participantIds;
      // Only participants can delete conversations
      allow delete: if isSignedIn() && request.auth.uid in resource.data.participantIds;
    }

    // Messages collection
    match /messages/{messageId} {
      // Helper to check if user is participant of the conversation
      function isParticipant() {
        let conversationId = request.resource.data.conversationId;
        let conversation = get(/databases/$(database)/documents/conversations/$(conversationId));
        return request.auth.uid in conversation.data.participantIds;
      }

      // Only conversation participants can read messages
      allow read: if isSignedIn();
      // Only sender who is a participant can create messages
      allow create: if isSignedIn() &&
                      request.resource.data.senderId == request.auth.uid &&
                      isParticipant();
      // Only the sender can update their own messages
      allow update: if isSignedIn() && resource.data.senderId == request.auth.uid;
      // Only the sender can delete their own messages
      allow delete: if isSignedIn() && resource.data.senderId == request.auth.uid;
    }

    // User follows collection
    match /user_follows/{followId} {
      // Anyone can read follow relationships
      allow read: if true;
      // Only the follower can create a follow relationship
      allow create: if isSignedIn() && request.resource.data.followerId == request.auth.uid;
      // Only the follower can delete their follow relationship
      allow delete: if isSignedIn() && resource.data.followerId == request.auth.uid;
    }

    // Shared spaces collection
    match /shared_spaces/{spaceId} {
      // Only members can read the shared space
      allow read: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Only the creator can create a shared space
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // Only members can update the shared space
      allow update: if isSignedIn() && request.auth.uid in resource.data.memberIds;
      // Only the creator can delete the shared space
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Media collection
    match /media/{mediaId} {
      // Anyone can read media (if they know the ID)
      allow read: if true;
      // Only signed-in users can create media
      allow create: if isSignedIn();
      // Only the uploader can update/delete their media
      allow update, delete: if isSignedIn() && resource.data.uploaderId == request.auth.uid;
    }

    // Stories collection
    match /stories/{storyId} {
      // Anyone can read stories
      allow read: if true;
      // Only signed-in users can create stories
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid;
      // Only the author can update/delete their stories
      allow update, delete: if isSignedIn() && resource.data.authorId == request.auth.uid;
    }

    // Calls collection
    match /calls/{callId} {
      // Only participants can read call records
      allow read: if isSignedIn() &&
                    (request.auth.uid == resource.data.callerId ||
                     request.auth.uid == resource.data.receiverId);
      // Only the caller can create a call record
      allow create: if isSignedIn() && request.resource.data.callerId == request.auth.uid;
      // Only participants can update call records
      allow update: if isSignedIn() &&
                      (request.auth.uid == resource.data.callerId ||
                       request.auth.uid == resource.data.receiverId);
      // Only participants can delete call records
      allow delete: if isSignedIn() &&
                      (request.auth.uid == resource.data.callerId ||
                       request.auth.uid == resource.data.receiverId);
    }
  }
}
